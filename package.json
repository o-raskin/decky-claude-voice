{
  "name": "claude-voice",
  "version": "0.1.0",
  "description": "Claude Code with voice dictation in the Quick Access Menu",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "vitest run --coverage",
    "test:py": "uv run --python 3.13 --with pytest --with pytest-asyncio --with pytest-cov pytest"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react-dom": "18.3.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "author": "o-raskin",
  "repository": {
    "type": "git",
    "url": "https://github.com/o-raskin/decky-claude-voice"
  }
}
